{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.561.group/number/cash-flow-result.schema.json",
  "title": "Exact cash flow result (default host profile)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "currency",
    "periodUnit",
    "rate",
    "cashFlows",
    "total",
    "roundedTotal",
    "roundingResidual",
    "rounding",
    "limits"
  ],
  "properties": {
    "kind": {
      "const": "exact-number.cash-flow/v1"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{2,11}$"
    },
    "periodUnit": {
      "enum": [
        "day",
        "month",
        "year"
      ]
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "num",
        "den"
      ],
      "properties": {
        "kind": {
          "const": "exactNumber.rational"
        },
        "num": {
          "type": "string",
          "pattern": "^(?:0|-?[1-9][0-9]*)$",
          "maxLength": 16384
        },
        "den": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 16384
        }
      }
    },
    "cashFlows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "period",
          "amount",
          "discountFactor",
          "presentValue"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "period": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1200
          },
          "amount": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "num",
              "den"
            ],
            "properties": {
              "kind": {
                "const": "exactNumber.rational"
              },
              "num": {
                "type": "string",
                "pattern": "^(?:0|-?[1-9][0-9]*)$",
                "maxLength": 16384
              },
              "den": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$",
                "maxLength": 16384
              }
            }
          },
          "discountFactor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "num",
              "den"
            ],
            "properties": {
              "kind": {
                "const": "exactNumber.rational"
              },
              "num": {
                "type": "string",
                "pattern": "^(?:0|-?[1-9][0-9]*)$",
                "maxLength": 16384
              },
              "den": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$",
                "maxLength": 16384
              }
            }
          },
          "presentValue": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "num",
              "den"
            ],
            "properties": {
              "kind": {
                "const": "exactNumber.rational"
              },
              "num": {
                "type": "string",
                "pattern": "^(?:0|-?[1-9][0-9]*)$",
                "maxLength": 16384
              },
              "den": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$",
                "maxLength": 16384
              }
            }
          }
        }
      }
    },
    "total": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "num",
        "den"
      ],
      "properties": {
        "kind": {
          "const": "exactNumber.rational"
        },
        "num": {
          "type": "string",
          "pattern": "^(?:0|-?[1-9][0-9]*)$",
          "maxLength": 16384
        },
        "den": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 16384
        }
      }
    },
    "roundedTotal": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "maxLength": 16384
    },
    "roundingResidual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "num",
        "den"
      ],
      "properties": {
        "kind": {
          "const": "exactNumber.rational"
        },
        "num": {
          "type": "string",
          "pattern": "^(?:0|-?[1-9][0-9]*)$",
          "maxLength": 16384
        },
        "den": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 16384
        }
      }
    },
    "rounding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "places",
        "mode"
      ],
      "properties": {
        "places": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "mode": {
          "enum": [
            "half-even",
            "half-away-from-zero",
            "toward-zero"
          ]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxCashFlows",
        "maxPeriod",
        "maxDigits",
        "maxPlaces",
        "maxArithmeticDigits"
      ],
      "properties": {
        "maxCashFlows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maxPeriod": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "maxDigits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maxPlaces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "maxArithmeticDigits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    }
  }
}
