{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.561.group/number/cash-flow-request.schema.json",
  "title": "Exact cash flow request (default host profile)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "currency",
    "periodUnit",
    "rate",
    "cashFlows",
    "rounding"
  ],
  "properties": {
    "currency": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{2,11}$"
    },
    "periodUnit": {
      "enum": [
        "day",
        "month",
        "year"
      ]
    },
    "rate": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "maxLength": 130,
      "description": "Exact decimal; admission additionally limits numeric digits to128 and rate to >-1."
    },
    "cashFlows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "period",
          "amount"
        ],
        "properties": {
          "period": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1200
          },
          "amount": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
            "maxLength": 130,
            "description": "Exact signed decimal cash flow; admission additionally limits numeric digits to128. Negative amounts are allowed."
          }
        }
      }
    },
    "rounding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "places",
        "mode"
      ],
      "properties": {
        "places": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "mode": {
          "enum": [
            "half-even",
            "half-away-from-zero",
            "toward-zero"
          ]
        }
      }
    }
  }
}
